/** Run once: the hourly refresh, the menu on open, and a first refresh. */
function servicePagesInstall() {
  const handlers = ['servicePagesRefresh', 'servicePagesMenu']
  for (const trigger of ScriptApp.getProjectTriggers()) {
    if (handlers.includes(trigger.getHandlerFunction())) ScriptApp.deleteTrigger(trigger)
  }
  ScriptApp.newTrigger('servicePagesRefresh').timeBased().everyHours(1).create()
  ScriptApp.newTrigger('servicePagesMenu').forSpreadsheet(SpreadsheetApp.getActive()).onOpen().create()
  servicePagesMenu()
  servicePagesRefresh()
}

function servicePagesMenu() {
  SpreadsheetApp.getUi().createMenu('Service pages').addItem('Refresh from Sanity', 'servicePagesRefresh').addToUi()
}

function servicePagesRefresh() {
  const lock = LockService.getDocumentLock()
  lock.waitLock(30000)
  try {
    const response = UrlFetchApp.fetch(SP_CONFIG.queryUrl, {muteHttpExceptions: true})
    if (response.getResponseCode() !== 200) throw new Error(`Sanity answered ${response.getResponseCode()}: ${response.getContentText().slice(0, 200)}`)
    const docs = JSON.parse(response.getContentText()).result
    if (!Array.isArray(docs)) throw new Error('Sanity returned no page list')

    const spreadsheet = SpreadsheetApp.getActive()
    const sheet = spreadsheet.getSheetByName(SP_CONFIG.tab) || spreadsheet.insertSheet(SP_CONFIG.tab)
    const values = sheet.getDataRange().getDisplayValues()
    const existingHeaders = values.length && values[0].some((cell) => cell !== '') ? values[0] : []
    const existingRows = values.slice(1).map((cells) => Object.fromEntries(existingHeaders.map((header, i) => [header, cells[i] || ''])))

    const properties = PropertiesService.getDocumentProperties()
    const stored = properties.getProperties()
    const hashOf = (row, headers) => Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, spContent(row, headers), Utilities.Charset.UTF_8))

    const result = spMerge(docs, existingHeaders, existingRows, (row, headers) => stored[`sp:${row._id}`] === hashOf(row, headers))
    const table = [result.headers, ...result.rows.map((row) => result.headers.map((header) => row[header] || ''))]
    const tooLong = table.flat().find((cell) => cell.length > 50000)
    if (tooLong) throw new Error(`A cell is longer than Google Sheets allows (50,000 characters): ${tooLong.slice(0, 80)}`)

    sheet.clearContents()
    if (sheet.getMaxColumns() < result.headers.length) sheet.insertColumnsAfter(sheet.getMaxColumns(), result.headers.length - sheet.getMaxColumns())
    if (sheet.getMaxRows() < table.length) sheet.insertRowsAfter(sheet.getMaxRows(), table.length - sheet.getMaxRows())
    const range = sheet.getRange(1, 1, table.length, result.headers.length)
    range.setNumberFormat('@') // plain text: "1,223" stays "1,223", "=..." is never a formula
    range.setValues(table)
    sheet.setFrozenRows(1)
    sheet.getRange(1, 1, 1, result.headers.length).setFontWeight('bold')

    for (const key of Object.keys(stored)) if (key.startsWith('sp:')) properties.deleteProperty(key)
    for (const row of result.rows) if (result.fromSanity.has(row._id)) properties.setProperty(`sp:${row._id}`, hashOf(row, result.headers))

    const kept = result.rows.length - result.fromSanity.size
    spreadsheet.toast(`${result.fromSanity.size} published page(s) refreshed from Sanity${kept ? `, ${kept} row(s) kept as written in the sheet` : ''}.`, 'Service pages', 8)
  } finally {
    lock.releaseLock()
  }
}

// ---------- Pure helpers (no Google services; tested in the repo: scripts/test-page-sheet.ts) ----------

/** Columns from the schema, each list with `capacity[key]` items; mirrors scripts/lib/page-sheet.ts. */
function spColumns(capacity) {
  const columns = []
  const walk = (fields, prefix, listKey) => {
    for (const field of fields) {
      const path = prefix + field.n
      const key = listKey ? `${listKey}.${field.n}` : field.n
      if (field.k === 'object') walk(field.f, `${path}.`, key)
      else if (field.k === 'list') {
        for (let i = 1; i <= (capacity[key] || 0); i++) {
          if (field.i.k === 'object') walk(field.i.f, `${path}[${i}].`, key)
          else columns.push({path: `${path}[${i}]`, kind: field.i.k})
        }
      } else columns.push({path, kind: field.k})
    }
  }
  walk(SP_CONFIG.schema, '', '')
  return columns
}

/** Every list path in the schema ("faqs", "equipment.comparison.rows.values"). */
function spListKeys() {
  const keys = []
  const walk = (fields, listKey) => {
    for (const field of fields) {
      const key = listKey ? `${listKey}.${field.n}` : field.n
      if (field.k === 'list') { keys.push(key); if (field.i.k === 'object') walk(field.i.f, key) }
      else if (field.k === 'object') walk(field.f, key)
    }
  }
  walk(SP_CONFIG.schema, '')
  return keys
}

/** Room for the longest list on any page plus headroom, and never fewer items than the sheet already has. */
function spCapacity(docs, headers) {
  const capacity = Object.fromEntries(spListKeys().map((key) => [key, SP_CONFIG.headroom]))
  const visit = (value, key) => {
    if (Array.isArray(value)) {
      if (key in capacity) capacity[key] = Math.max(capacity[key], value.length + SP_CONFIG.headroom)
      value.forEach((item) => visit(item, key))
    } else if (value && typeof value === 'object') {
      for (const name of Object.keys(value)) if (!name.startsWith('_')) visit(value[name], key ? `${key}.${name}` : name)
    }
  }
  docs.forEach((doc) => visit(doc, ''))
  for (const header of headers) {
    let key = ''
    for (const part of header.split('.')) {
      const match = part.match(/^([^[]+)((?:\[\d+\])*)$/)
      if (!match) break
      key = key ? `${key}.${match[1]}` : match[1]
      const index = match[2].match(/\[(\d+)\]/)
      if (index && key in capacity) capacity[key] = Math.max(capacity[key], Number(index[1]))
    }
  }
  return capacity
}

function spValueAt(doc, path) {
  let value = doc
  for (const part of path.split('.')) {
    const match = part.match(/^([^[]+)((?:\[\d+\])*)$/)
    const steps = [match[1], ...[...match[2].matchAll(/\[(\d+)\]/g)].map((index) => Number(index[1]) - 1)]
    for (const step of steps) {
      if (value == null || typeof value !== 'object') return undefined
      value = value[step]
    }
  }
  return value
}

function spCell(value, kind) {
  if (value === undefined || value === null || value === '') return ''
  if (kind === 'json') return JSON.stringify(value)
  if (kind === 'slug') return typeof value === 'object' ? String(value.current == null ? '' : value.current) : String(value)
  if (kind === 'reference') return typeof value === 'object' ? String(value._ref == null ? '' : value._ref) : String(value)
  return String(value)
}

/** The live address, the same rule as src/lib/service-urls.ts: /services/<group>/<slug>. */
function spUrl(slug, parentName) {
  if (!slug) return ''
  const groups = SP_CONFIG.groups
  const group = SP_CONFIG.nested ? (groups.byService[slug] || (parentName ? groups.byParentName[parentName.trim().toLowerCase()] : undefined)) : undefined
  return `${SP_CONFIG.origin}/services${group ? `/${group}` : ''}/${slug}`
}

function spRow(doc, columns) {
  const row = {_id: doc._id, _status: 'Published', _url: spUrl(doc.slug && doc.slug.current, doc.parentName), _updatedAt: doc._updatedAt}
  for (const column of columns) row[column.path] = spCell(spValueAt(doc, column.path), column.kind)
  return row
}

/** What a row says, for spotting edits: _id and the fields, not the bookkeeping this script fills in. */
function spContent(row, headers) {
  return JSON.stringify(headers.filter((header) => header === '_id' || !SP_CONFIG.meta.includes(header)).map((header) => row[header] || ''))
}

/**
 * The new tab: published pages in serviceId order, then every other row exactly as it was.
 * A page's row is replaced by Sanity's only when nobody edited it since this script wrote it
 * (`unchanged`) or it already says the same as Sanity; otherwise the sheet's row is kept.
 */
function spMerge(docs, existingHeaders, existingRows, unchanged) {
  const columns = spColumns(spCapacity(docs, existingHeaders))
  const generated = [...SP_CONFIG.meta, ...columns.map((column) => column.path)]
  const extra = existingHeaders.filter((header) => header && !generated.includes(header))
  const headers = [...generated, ...extra]
  const sorted = docs.slice().sort((a, b) => (a.serviceId || 0) - (b.serviceId || 0))
  const byId = new Map(existingRows.filter((row) => row._id).map((row) => [row._id, row]))
  const rows = []
  const fromSanity = new Set()
  for (const doc of sorted) {
    const fresh = spRow(doc, columns)
    const old = byId.get(doc._id)
    byId.delete(doc._id)
    if (!old || unchanged(old, existingHeaders) || spContent(old, headers) === spContent(fresh, headers)) {
      for (const header of extra) fresh[header] = old ? old[header] || '' : ''
      rows.push(fresh)
      fromSanity.add(doc._id)
    } else {
      const newer = (doc._updatedAt || '') > (old._updatedAt || '')
      rows.push({...old, _status: newer ? 'Edited in sheet; also changed in Sanity since' : 'Edited in sheet'})
    }
  }
  for (const row of existingRows) {
    if (row._id && !byId.has(row._id)) continue // already placed above
    if (!headers.some((header) => header !== '_status' && row[header])) continue // blank row
    const status = !row._id ? 'Not in Sanity yet' : row._status === 'Published' ? 'Not published' : row._status || 'Not published'
    rows.push({...row, _status: status})
  }
  return {headers, rows, fromSanity}
}
