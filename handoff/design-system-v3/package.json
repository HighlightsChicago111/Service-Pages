{
  "name": "highlights-chicago-service-pages-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start -p 3008",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev",
    "sanity:check": "tsx scripts/check-sanity.ts",
    "workbook:template": "python -I scripts/make_workbook.py",
    "content:extract": "python -I scripts/extract_workbook.py",
    "content:build": "tsx scripts/build-documents.ts",
    "content:push": "tsx scripts/push-documents.ts",
    "test:content": "tsx scripts/test-build-documents.ts"
  },
  "dependencies": {
    "@sanity/vision": "6.11.0",
    "next": "16.3.3",
    "next-sanity": "13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.11.0",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
